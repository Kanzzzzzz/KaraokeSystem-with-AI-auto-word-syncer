# ---------------------------------------------------------------------------
# Personal song library - NEVER commit this.
#
# data/library/ holds audio the user supplied themselves. Those files may be
# commercial recordings, so keeping them out of git is what lets this repo be
# shared publicly. The app reads data/samples/ (royalty-free, committed) and
# data/library/ (personal, ignored) exactly the same way, so nothing breaks
# for someone who clones the repo without these files.
# ---------------------------------------------------------------------------
data/library/

# Metadata corrections reference personal filenames, so the real file stays
# local. data/song_overrides.example.json is committed instead as a template.
data/song_overrides.json

# The SQLite database is generated by scripts/init_db.py, not source code.
# The -wal and -shm files are created by WAL journal mode (see database.py).
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# Python
__pycache__/
*.py[cod]
venv/
.venv/
env/
*.egg-info/

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
